<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.11</version>
        <relativePath/>
    </parent>
    <groupId>javapolis</groupId>
    <artifactId>factory-player</artifactId>
    <version>1.0.0</version>
    <name>JavaPolis Factory — local player</name>
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <test.groups></test.groups>
        <test.excluded>exercise</test.excluded>
        <factory.mode>student</factory.mode>
        <factory.sources>src/main/java</factory.sources>
        <factory.tests>src/test/java</factory.tests>
    </properties>
    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <sourceDirectory>${factory.sources}</sourceDirectory>
        <testSourceDirectory>${factory.tests}</testSourceDirectory>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                <configuration><groups>${test.groups}</groups><excludedGroups>${test.excluded}</excludedGroups></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>ui</id>
            <properties><factory.tests>src/ui-test/java</factory.tests></properties>
            <dependencies>
                <dependency><groupId>com.microsoft.playwright</groupId><artifactId>playwright</artifactId><version>1.51.0</version><scope>test</scope></dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version></plugin>
                    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes><include>**/FactoryBrowserTest.java</include></includes>
                            <systemPropertyVariables><factory.screenshots>${project.build.directory}/ui-screenshots</factory.screenshots></systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile><id>stage-1</id><properties><test.groups>stage-1</test.groups><test.excluded>none</test.excluded></properties></profile>
        <profile><id>stage-2</id><properties><test.groups>stage-2</test.groups><test.excluded>none</test.excluded></properties></profile>
        <profile><id>stage-3</id><properties><test.groups>stage-3</test.groups><test.excluded>none</test.excluded></properties></profile>
        <profile><id>stage-4</id><properties><test.groups>stage-4</test.groups><test.excluded>none</test.excluded></properties></profile>
        <profile><id>stage-5</id><properties><test.groups>stage-5</test.groups><test.excluded>none</test.excluded></properties></profile>
        <profile><id>all-stages</id><properties><test.excluded>none</test.excluded></properties></profile>
        <profile>
            <id>solution</id>
            <properties>
                <factory.mode>solution</factory.mode>
                <factory.sources>${project.build.directory}/reference-sources</factory.sources>
                <test.excluded>none</test.excluded>
            </properties>
            <build>
                <!-- Separate output prevents reference classes leaking into a student's next run. -->
                <directory>target/solution</directory>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId>
                        <executions><execution><id>reference-sources</id><phase>generate-sources</phase>
                            <goals><goal>copy-resources</goal></goals>
                            <configuration>
                                <outputDirectory>${factory.sources}</outputDirectory><overwrite>true</overwrite>
                                <resources>
                                    <resource><directory>src/main/java</directory><filtering>false</filtering></resource>
                                    <resource><directory>solutions</directory><filtering>false</filtering></resource>
                                </resources>
                            </configuration>
                        </execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
